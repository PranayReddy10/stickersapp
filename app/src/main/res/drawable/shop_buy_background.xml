<?xml version="1.0" encoding="utf-8"?>
<!-- The site's .btn.primary: a rose pill. Grey once there is nothing to buy. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/shop_line" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/shop_rose_dark" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/shop_rose" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
