<?xml version="1.0" encoding="utf-8"?>
<!-- BottomNavigationView refuses a sixth item. Reels took the slot Categories had,
     and My profile took the Subscriptions one. Categories are still reachable from the
     drawer and from pack pages, and a followed user from their own profile page. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/bottom_latest"
        android:icon="@drawable/ic_tab_home"
        android:enabled="true"
        android:checked="true"
        android:title="Latest" />

    <item
        android:id="@+id/bottom_popular"
        android:icon="@drawable/ic_tab_popular"
        android:title="Popular" />

    <item
        android:id="@+id/bottom_reels"
        android:icon="@drawable/ic_tab_reels"
        android:title="@string/reels" />

    <item
        android:id="@+id/bottom_fav"
        android:icon="@drawable/ic_tab_favorites"
        android:title="Favorites" />

    <!-- Opens the profile page rather than a pager page, so it is last and the four
         pager tabs above keep their positions. -->
    <item
        android:id="@+id/bottom_profile"
        android:icon="@drawable/ic_tab_profile"
        android:title="@string/my_profile" />

</menu>
