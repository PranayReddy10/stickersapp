<?xml version="1.0" encoding="utf-8"?>
<!-- One pack, as a compact row: cover, name, a single meta line and a strip of
     previews. The tall card this replaced was about 300dp, which put two packs on a
     screen; this is nearer 140dp, so four or five fit. Every id the adapter binds is
     still here - publisher and size are kept but hidden, since the meta line already
     carries the name and the pack page shows the rest. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="7dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardPreventCornerOverlap="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/pack_try_image"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/sticker_error"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/sticker_error"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/item_pack_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Pack Name"
                        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                        android:textColor="@color/primary_text"
                        android:textSize="17sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.github.siyamed.shapeimageview.CircularImageView
                            android:id="@+id/pack_item_image_view_userimage"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/profile" />

                        <TextView
                            android:id="@+id/item_pack_username"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="username"
                            android:textColor="@color/dark_gray"
                            android:textSize="12sp" />

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_marginStart="9dp"
                            android:layout_marginEnd="3dp"
                            app:tint="@color/dark_gray"
                            app:srcCompat="@drawable/ic_file_download"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/item_pack_downloads"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12.7K"
                            android:textColor="@color/dark_gray"
                            android:textSize="12sp" />

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_marginStart="9dp"
                            android:layout_marginEnd="3dp"
                            app:tint="@color/dark_gray"
                            app:srcCompat="@drawable/ic_time"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/item_pack_created"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="2h"
                            android:textColor="@color/dark_gray"
                            android:textSize="12sp" />

                        <!-- Still bound by the adapter; the pack page carries them. -->
                        <TextView
                            android:id="@+id/item_pack_publisher"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/item_pack_size"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/image_view_whatsapp"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:padding="3dp"
                            android:visibility="gone"
                            app:tint="#25D366"
                            app:srcCompat="@drawable/ic_whatsapp"
                            android:contentDescription="@null" />

                        <ImageView
                            android:id="@+id/image_view_telegram"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="3dp"
                            android:padding="3dp"
                            android:visibility="gone"
                            app:tint="#0088cc"
                            app:srcCompat="@drawable/ic_telegram"
                            android:contentDescription="@null" />

                        <ImageView
                            android:id="@+id/image_view_signal"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="3dp"
                            android:visibility="gone"
                            app:tint="#007bff"
                            app:srcCompat="@drawable/ic_signal"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/image_view_item_pack_fav"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    app:tint="@color/menuSelector"
                    app:srcCompat="@drawable/ic_favorite_black"
                    android:contentDescription="@null" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/image_view_menu_item"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    app:tint="@color/primary_text_light"
                    app:srcCompat="@drawable/ic_more" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/sticker_one"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:background="@drawable/sticker_error"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/sticker_two"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/sticker_error"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/sticker_three"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/sticker_error"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/sticker_four"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/sticker_error"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/sticker_five"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/sticker_error"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/sticker_six"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/sticker_error"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <RelativeLayout
        android:visibility="gone"
        android:elevation="10dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="2dp"
        android:layout_alignParentLeft="true"
        android:id="@+id/item_pack_premium"
        android:paddingLeft="4dp"
        android:paddingRight="5dp"
        android:gravity="center"
        android:background="@drawable/background_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:padding="1dp"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:tint="@color/white"
            app:srcCompat="@drawable/ic_attach_money" />
        <TextView
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:gravity="top"
            android:textColor="@color/white"
            android:text="Premium"
            android:textSize="12dp"
            android:layout_marginLeft="13dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </RelativeLayout>
    <RelativeLayout
        android:visibility="gone"
        android:elevation="10dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="2dp"
        android:layout_alignParentLeft="true"
        android:id="@+id/item_pack_delete"
        android:gravity="center"
        android:background="@drawable/background_btn_red"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/image_view_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginStart="0dp"
            android:layout_marginLeft="0dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="5dp"
            app:tint="@color/white"
            app:srcCompat="@drawable/ic_delete_review" />
        <TextView
            android:visibility="gone"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:gravity="top"
            android:textColor="@color/white"
            android:text="Delete"
            android:textSize="12dp"
            android:layout_marginLeft="17dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </RelativeLayout>
    <RelativeLayout

        android:visibility="gone"
        android:elevation="10dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="2dp"
        android:layout_alignParentRight="true"
        android:id="@+id/item_pack_review"
        android:paddingLeft="4dp"
        android:paddingRight="5dp"
        android:gravity="center"
        android:background="@drawable/background_btn_red"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:padding="1dp"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:tint="@color/white"
            app:srcCompat="@drawable/ic_time" />
        <TextView
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:gravity="top"
            android:textColor="@color/white"
            android:text="On Review"
            android:textSize="12dp"
            android:layout_marginLeft="17dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </RelativeLayout>
</RelativeLayout>
