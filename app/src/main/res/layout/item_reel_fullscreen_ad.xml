<?xml version="1.0" encoding="utf-8"?>
<!-- An ad page between reels in the full screen pager. The ad fills the page, the same
     as a reel does; dark underneath so it never flashes white between two videos. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E10">

    <FrameLayout
        android:id="@+id/frame_layout_fullscreen_ad"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:alpha="0.5"
        android:text="@string/reel_swipe_up"
        android:textColor="@android:color/white"
        android:textSize="13sp" />
</FrameLayout>
