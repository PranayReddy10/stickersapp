<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/text_view_personalisation_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jakarta_bold"
        android:textColor="@color/shop_ink"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/text_view_personalisation_help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/jakarta"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/shop_ink_2"
        android:textSize="12.5sp" />
</LinearLayout>
