<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_upload_reel"
        style="@style/ActionBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:elevation="0dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reel_new_title"
                android:textColor="@color/primary_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="18dp"
                android:text="@string/reel_new_subtitle"
                android:textColor="@color/primary_text_light"
                android:textSize="14sp" />

            <!-- Media picker / preview -->
            <FrameLayout
                android:id="@+id/frame_layout_preview"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:background="@drawable/bg_upload_dashed">

                <ImageView
                    android:id="@+id/image_view_reel_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:id="@+id/linear_layout_pick"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_upload_reel"
                        app:tint="@color/colorAccent"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/reel_pick"
                        android:textColor="@color/primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/reel_pick_formats"
                        android:textColor="@color/primary_text_light"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_view_media_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_type_badge"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/text_view_change_media"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_type_badge"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="@string/reel_change"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:text="@string/reel_caption_label"
                android:textColor="@color/primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_text_reel_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_upload_field"
                android:gravity="top"
                android:hint="@string/reel_caption_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500"
                android:maxLines="5"
                android:minLines="3"
                android:padding="16dp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/primary_text_light"
                android:textSize="15sp"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/text_view_caption_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="end"
                android:textColor="@color/primary_text_light"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/progress_bar_upload_reel"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="16dp"
                android:max="100"
                android:progressTint="@color/colorAccent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_view_upload_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/primary_text_light"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Pinned so the action is always reachable, whatever the caption length. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="12dp"
        android:padding="14dp">

        <TextView
            android:id="@+id/button_post_reel"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_upload_button"
            android:gravity="center"
            android:text="@string/reel_post"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
