<?xml version="1.0" encoding="utf-8"?>
<!-- Posting a reel in two steps: pick the media, then describe it. The step is only ever
     one of the two blocks below being visible; the toolbar's back arrow walks back through
     them rather than leaving, so a caption already typed is never lost. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_upload_reel"
        style="@style/ActionBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/app_background"
        app:elevation="0dp" />

    <!-- Two marks, the second filling in on step two. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="2dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <View
            android:id="@+id/view_step_one"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_upload_step" />

        <View
            android:id="@+id/view_step_two"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_upload_step" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <!-- ===================== step one: pick ===================== -->
            <LinearLayout
                android:id="@+id/layout_step_pick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reel_new_title"
                    android:textColor="@color/primary_text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="18dp"
                    android:text="@string/reel_new_subtitle"
                    android:textColor="@color/primary_text_light"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/linear_layout_pick"
                    android:layout_width="match_parent"
                    android:layout_height="380dp"
                    android:background="@drawable/bg_upload_dashed"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:src="@drawable/ic_upload_reel"
                        app:tint="@color/green"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/reel_pick"
                        android:textColor="@color/primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/reel_pick_formats"
                        android:textColor="@color/primary_text_light"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== step two: details ===================== -->
            <LinearLayout
                android:id="@+id/layout_step_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- What is being posted, small: the picking is done, this is the receipt. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_upload_field"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:id="@+id/frame_layout_preview"
                        android:layout_width="76dp"
                        android:layout_height="104dp"
                        android:background="#111317">

                        <ImageView
                            android:id="@+id/image_view_reel_preview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/text_view_media_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_reel_pill"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:textColor="@android:color/white"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_view_media_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:textColor="@color/primary_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_view_upload_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/primary_text_light"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/text_view_change_media"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/reel_change"
                            android:textColor="@color/green"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/reel_caption_label"
                    android:textColor="@color/primary_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edit_text_reel_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_upload_field"
                    android:gravity="top"
                    android:hint="@string/reel_caption_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="500"
                    android:maxLines="5"
                    android:minLines="3"
                    android:padding="16dp"
                    android:textColor="@color/primary_text"
                    android:textColorHint="@color/primary_text_light"
                    android:textSize="15sp"
                    android:importantForAutofill="no" />

                <TextView
                    android:id="@+id/text_view_caption_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="end"
                    android:textColor="@color/primary_text_light"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/progress_bar_upload_reel"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="18dp"
                    android:max="100"
                    android:progressTint="@color/colorAccent"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Pinned so the action is always reachable, whatever the caption length. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="12dp"
        android:padding="14dp">

        <TextView
            android:id="@+id/button_post_reel"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_upload_button"
            android:gravity="center"
            android:text="@string/reel_post"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
