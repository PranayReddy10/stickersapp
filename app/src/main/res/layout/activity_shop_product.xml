<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shop_paper"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_shop_product"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/shop_paper"
        app:elevation="0dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextColor="@color/shop_ink" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="22dp">

            <!-- ============================ pictures ============================ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="@color/shop_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/view_pager_product_images"
                        android:layout_width="match_parent"
                        android:layout_height="320dp" />

                    <TextView
                        android:id="@+id/text_view_product_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="12dp"
                        android:background="@drawable/shop_counter_background"
                        android:fontFamily="@font/jakarta_semibold"
                        android:paddingStart="11dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="11dp"
                        android:paddingBottom="5dp"
                        android:textColor="@color/shop_card"
                        android:textSize="11.5sp"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- ============================== name =============================== -->
            <TextView
                android:id="@+id/text_view_product_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="18dp"
                android:fontFamily="@font/jakarta_bold"
                android:letterSpacing="0.07"
                android:textAllCaps="true"
                android:textColor="@color/shop_rose"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/text_view_product_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="18dp"
                android:fontFamily="@font/fraunces_bold"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/shop_ink"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/text_view_product_rating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="18dp"
                android:fontFamily="@font/jakarta"
                android:textColor="@color/shop_ink_2"
                android:textSize="12.5sp" />

            <!-- ====================== price, the site's block ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/shop_price_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/text_view_product_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fraunces_bold"
                    android:textColor="@color/shop_rose"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/text_view_product_was_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/jakarta"
                    android:textColor="@color/shop_muted"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/text_view_product_stock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/jakarta_bold"
                    android:paddingStart="11dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="5dp"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_view_product_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="18dp"
                android:fontFamily="@font/jakarta"
                android:textColor="@color/shop_ink_2"
                android:textSize="12.5sp" />

            <!-- ============================ variants ============================= -->
            <LinearLayout
                android:id="@+id/linear_layout_product_variants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    style="@style/ShopSectionTitle"
                    android:text="@string/shop_choose_option" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_product_variants"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- ========================= personalisation ========================= -->
            <LinearLayout
                android:id="@+id/linear_layout_product_personalisation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical">

                <TextView
                    style="@style/ShopSectionTitle"
                    android:text="@string/shop_personalisation" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    app:cardBackgroundColor="@color/shop_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:id="@+id/linear_layout_personalisation_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- =========================== description =========================== -->
            <LinearLayout
                android:id="@+id/linear_layout_product_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical">

                <TextView
                    style="@style/ShopSectionTitle"
                    android:text="@string/shop_about" />

                <TextView
                    android:id="@+id/text_view_product_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:fontFamily="@font/jakarta"
                    android:lineSpacingExtra="5dp"
                    android:textColor="@color/shop_ink_2"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ============================= related ============================= -->
            <LinearLayout
                android:id="@+id/linear_layout_product_related"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/ShopSectionTitle"
                    android:text="@string/shop_related" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_product_related"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ============================== buy bar ============================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/shop_card"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/button_product_buy"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/shop_buy_background"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/jakarta_bold"
            android:gravity="center"
            android:text="@string/shop_buy"
            android:textColor="@color/shop_buy_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/jakarta"
            android:gravity="center"
            android:text="@string/shop_buy_note"
            android:textColor="@color/shop_muted"
            android:textSize="11.5sp" />
    </LinearLayout>
</LinearLayout>
