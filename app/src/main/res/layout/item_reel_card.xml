<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- Author row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <com.github.siyamed.shapeimageview.CircularImageView
                android:id="@+id/image_view_card_avatar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/profile"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_view_card_author"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/image_view_card_verified"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_verified_reel"
                        android:visibility="gone"
                        android:contentDescription="@null" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_view_card_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary_text_light"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_view_card_follow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_follow_button"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="@string/reel_follow"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/image_view_card_more"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:padding="4dp"
                android:src="@drawable/ic_more"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Media. Height is set from the reel's own aspect ratio in the adapter. -->
        <FrameLayout
            android:id="@+id/frame_layout_card_media"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="12dp"
            android:background="#08000000">

            <ImageView
                android:id="@+id/image_view_card_media"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/image_view_card_play"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:alpha="0.9"
                android:src="@drawable/ic_play_circle"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/image_view_card_like"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_reel_heart_outline"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/text_view_card_likes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="20dp"
                android:textColor="@color/primary_text"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/image_view_card_share"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_reel_send"
                android:contentDescription="@null" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_reel_views"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/text_view_card_views"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/primary_text_light"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_view_card_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/primary_text"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
